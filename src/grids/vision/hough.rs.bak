#[cfg(feature = "vision-grids")]
use opencv::prelude::*;
#[cfg(feature = "vision-grids")]
use opencv::{core, imgproc};
#[cfg(feature = "vision-grids")]
use std::collections::HashMap;

#[cfg(feature = "vision-grids")]
use crate::grids::GridLayout;
#[cfg(feature = "vision-grids")]
use crate::types::{GridCell, GridCoord, KeyCode, Rectangle, ScreenCoord};
#[cfg(feature = "vision-grids")]
use crate::x11_client::ScreenInfo;
#[cfg(feature = "vision-grids")]
use crate::constants::*;

#[cfg(feature = "vision-grids")]
pub struct HoughGrid {
    screenshot: Option<core::Mat>,
    detected_lines: Vec<core::Vec4i>,
    intersection_points: Vec<ScreenCoord>,
    last_update: std::time::Instant,
    refresh_interval: std::time::Duration,
    jump_target_map: HashMap<KeyCode, usize>, // Maps number keys to intersection indices
}

#[cfg(feature = "vision-grids")]
impl Default for HoughGrid {
    fn default() -> Self {
        Self::new()
    }
}

#[cfg(feature = "vision-grids")]
impl HoughGrid {
    pub fn new() -> Self {
        let mut jump_target_map = HashMap::new();
        // Map number keys 1-9 to jump targets
        jump_target_map.insert(KEYCODE_1, 0);
        jump_target_map.insert(KEYCODE_2, 1);
        jump_target_map.insert(KEYCODE_3, 2);
        jump_target_map.insert(KEYCODE_4, 3);
        jump_target_map.insert(KEYCODE_5, 4);
        jump_target_map.insert(KEYCODE_6, 5);
        jump_target_map.insert(KEYCODE_7, 6);
        jump_target_map.insert(KEYCODE_8, 7);
        jump_target_map.insert(KEYCODE_9, 8);
        
        Self {
            screenshot: None,
            detected_lines: Vec::new(),
            intersection_points: Vec::new(),
            last_update: std::time::Instant::now(),
            refresh_interval: std::time::Duration::from_millis(500), // Refresh every 500ms
            jump_target_map,
        }
    }

    fn update_screenshot_if_needed(&mut self, screen: &ScreenInfo) -> Result<(), opencv::Error> {
        let now = std::time::Instant::now();
        if now.duration_since(self.last_update) > self.refresh_interval || self.screenshot.is_none() {
            // TODO: Implement actual X11 screenshot capture
            // For now, create a dummy image
            self.screenshot = Some(core::Mat::zeros(
                screen.height as i32,
                screen.width as i32,
                core::CV_8UC3,
            )?.to_mat()?);
            
            self.detect_lines_and_intersections(screen)?;
            self.last_update = now;
        }
        Ok(())
    }

    fn detect_lines_and_intersections(&mut self, _screen: &ScreenInfo) -> Result<(), opencv::Error> {
        if let Some(ref screenshot) = self.screenshot {
            // Convert to grayscale
            let mut gray = core::Mat::default();
            imgproc::cvt_color(screenshot, &mut gray, imgproc::COLOR_BGR2GRAY, 0)?;

            // Apply Gaussian blur to reduce noise
            let mut blurred = core::Mat::default();
            imgproc::gaussian_blur(
                &gray,
                &mut blurred,
                core::Size::new(5, 5),
                1.4,
                0.0,
                core::BORDER_DEFAULT,
            )?;

            // Edge detection using Canny
            let mut edges = core::Mat::default();
            imgproc::canny(&blurred, &mut edges, 50.0, 150.0, 3, false)?;

            // Hough line transform
            let mut lines = core::Mat::default();
            imgproc::hough_lines_p(
                &edges,
                &mut lines,
                1.0,                    // rho resolution
                std::f64::consts::PI / 180.0, // theta resolution
                50,                     // threshold
                50.0,                   // min line length
                10.0,                   // max line gap
            )?;

            // Extract lines
            self.detected_lines.clear();
            for i in 0..lines.rows() {
                let line = lines.at_2d::<core::Vec4i>(i, 0)?;
                self.detected_lines.push(*line);
            }

            // Find intersections
            self.find_intersections();
        }
        Ok(())
    }

    fn find_intersections(&mut self) {
        self.intersection_points.clear();
        
        // Find intersections between detected lines
        for (i, line1) in self.detected_lines.iter().enumerate() {
            for line2 in self.detected_lines.iter().skip(i + 1) {
                if let Some(intersection) = self.line_intersection(line1, line2) {
                    self.intersection_points.push(intersection);
                }
            }
        }

        // Sort by distance from top-left corner to make selection predictable
        self.intersection_points.sort_by_key(|point| {
            (point.x * point.x + point.y * point.y) as i32
        });

        // Keep only the first 9 intersections (for keys 1-9)
        self.intersection_points.truncate(9);
    }

    fn line_intersection(&self, line1: &core::Vec4i, line2: &core::Vec4i) -> Option<ScreenCoord> {
        let (x1, y1, x2, y2) = (line1[0], line1[1], line1[2], line1[3]);
        let (x3, y3, x4, y4) = (line2[0], line2[1], line2[2], line2[3]);

        let denominator = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
        if denominator == 0 {
            return None; // Lines are parallel
        }

        let t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) as f64 / denominator as f64;
        let u = -((x1 - x2) * (y1 - y3) - (y1 - y2) * (x1 - x3)) as f64 / denominator as f64;

        // Check if intersection is within both line segments
        if t >= 0.0 && t <= 1.0 && u >= 0.0 && u <= 1.0 {
            let x = x1 as f64 + t * (x2 - x1) as f64;
            let y = y1 as f64 + t * (y2 - y1) as f64;
            Some(ScreenCoord {
                x: x as i32,
                y: y as i32,
            })
        } else {
            None
        }
    }
}

#[cfg(feature = "vision-grids")]
impl GridLayout for HoughGrid {
    fn calculate_grid(&self, screen: &ScreenInfo, _density: u32) -> Vec<GridCell> {
        let mut cells = Vec::new();
        
        // Create cells for each intersection point
        for (i, &point) in self.intersection_points.iter().enumerate() {
            if i >= 9 {
                break; // Only support 9 jump targets
            }
            
            let label = format!("{}", i + 1);
            let cell_size = 40; // Small square around intersection
            
            cells.push(GridCell {
                coord: GridCoord {
                    x: i as u32,
                    y: 0,
                },
                screen_rect: Rectangle {
                    x: point.x - cell_size / 2,
                    y: point.y - cell_size / 2,
                    width: cell_size as u32,
                    height: cell_size as u32,
                },
                label,
            });
        }

        cells
    }

    fn process_key(&mut self, key: KeyCode, _current_level: u32) -> Option<GridCoord> {
        if let Some(&index) = self.jump_target_map.get(&key) {
            if index < self.intersection_points.len() {
                return Some(GridCoord {
                    x: index as u32,
                    y: 0,
                });
            }
        }
        None
    }

    fn process_key_with_screen(
        &mut self,
        key: KeyCode,
        current_level: u32,
        screen: &ScreenInfo,
        _density: u32,
    ) -> Option<GridCoord> {
        // Update screenshot if needed
        if let Err(_) = self.update_screenshot_if_needed(screen) {
            // If screenshot update fails, fall back to basic processing
            return self.process_key(key, current_level);
        }
        
        self.process_key(key, current_level)
    }

    fn name(&self) -> &'static str {
        "Hough Lines Grid"
    }

    fn reset(&mut self) {
        // Force refresh on next use
        self.last_update = std::time::Instant::now() - self.refresh_interval;
    }
}

#[cfg(all(test, feature = "vision-grids"))]
mod tests {
    use super::*;
    use crate::x11_client::ScreenInfo;

    fn mock_screen() -> ScreenInfo {
        ScreenInfo {
            width: 1024,
            height: 768,
            root_window: 0,
        }
    }

    #[test]
    fn test_hough_grid_creation() {
        let grid = HoughGrid::new();
        assert_eq!(grid.name(), "Hough Lines Grid");
        assert_eq!(grid.intersection_points.len(), 0);
    }

    #[test]
    fn test_hough_grid_key_mapping() {
        let mut grid = HoughGrid::new();
        
        // Add some mock intersection points
        grid.intersection_points = vec![
            ScreenCoord { x: 100, y: 100 },
            ScreenCoord { x: 200, y: 200 },
        ];

        let result = grid.process_key(KEYCODE_1, 0);
        assert!(result.is_some());
        let coord = result.unwrap();
        assert_eq!(coord.x, 0); // First intersection
        
        let result = grid.process_key(KEYCODE_2, 0);
        assert!(result.is_some());
        let coord = result.unwrap();
        assert_eq!(coord.x, 1); // Second intersection
    }

    #[test]
    fn test_hough_grid_calculate() {
        let mut grid = HoughGrid::new();
        let screen = mock_screen();
        
        // Add some mock intersection points
        grid.intersection_points = vec![
            ScreenCoord { x: 100, y: 100 },
            ScreenCoord { x: 200, y: 200 },
            ScreenCoord { x: 300, y: 300 },
        ];

        let cells = grid.calculate_grid(&screen, 4);
        assert_eq!(cells.len(), 3); // Should have cells for each intersection
        
        // Check first cell
        assert_eq!(cells[0].label, "1");
        assert_eq!(cells[0].coord.x, 0);
    }

    #[test]
    fn test_line_intersection() {
        let grid = HoughGrid::new();
        
        // Two intersecting lines: horizontal and vertical
        let line1 = core::Vec4i::from([0, 100, 200, 100]); // Horizontal line
        let line2 = core::Vec4i::from([100, 0, 100, 200]); // Vertical line
        
        let intersection = grid.line_intersection(&line1, &line2);
        assert!(intersection.is_some());
        
        let point = intersection.unwrap();
        assert_eq!(point.x, 100);
        assert_eq!(point.y, 100);
    }

    #[test]
    fn test_parallel_lines_no_intersection() {
        let grid = HoughGrid::new();
        
        // Two parallel lines
        let line1 = core::Vec4i::from([0, 100, 200, 100]); // Horizontal line
        let line2 = core::Vec4i::from([0, 200, 200, 200]); // Another horizontal line
        
        let intersection = grid.line_intersection(&line1, &line2);
        assert!(intersection.is_none());
    }
}