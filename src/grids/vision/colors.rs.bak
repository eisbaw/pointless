#[cfg(feature = "vision-grids")]
use opencv::prelude::*;
#[cfg(feature = "vision-grids")]
use opencv::{core, imgproc};
#[cfg(feature = "vision-grids")]
use std::collections::HashMap;

#[cfg(feature = "vision-grids")]
use crate::grids::GridLayout;
#[cfg(feature = "vision-grids")]
use crate::types::{GridCell, GridCoord, KeyCode, Rectangle, ScreenCoord};
#[cfg(feature = "vision-grids")]
use crate::x11_client::ScreenInfo;
#[cfg(feature = "vision-grids")]
use crate::constants::*;

#[cfg(feature = "vision-grids")]
pub struct ColorGrid {
    screenshot: Option<core::Mat>,
    color_regions: Vec<ColorRegion>,
    last_update: std::time::Instant,
    refresh_interval: std::time::Duration,
    jump_target_map: HashMap<KeyCode, usize>,
    num_clusters: i32, // Number of color clusters for k-means
    min_region_area: i32, // Minimum area for color regions
}

#[cfg(feature = "vision-grids")]
#[derive(Debug, Clone)]
struct ColorRegion {
    center: ScreenCoord,
    dominant_color: core::Vec3b, // BGR color
    area: i32,
    bounding_rect: core::Rect,
}

#[cfg(feature = "vision-grids")]
impl Default for ColorGrid {
    fn default() -> Self {
        Self::new()
    }
}

#[cfg(feature = "vision-grids")]
impl ColorGrid {
    pub fn new() -> Self {
        let mut jump_target_map = HashMap::new();
        // Map number keys 1-9 to jump targets
        for i in 1..=9 {
            let keycode = match i {
                1 => KEYCODE_1,
                2 => KEYCODE_2,
                3 => KEYCODE_3,
                4 => KEYCODE_4,
                5 => KEYCODE_5,
                6 => KEYCODE_6,
                7 => KEYCODE_7,
                8 => KEYCODE_8,
                9 => KEYCODE_9,
                _ => continue,
            };
            jump_target_map.insert(keycode, i - 1);
        }

        Self {
            screenshot: None,
            color_regions: Vec::new(),
            last_update: std::time::Instant::now(),
            refresh_interval: std::time::Duration::from_millis(750), // Slower refresh for color analysis
            jump_target_map,
            num_clusters: 8, // Cluster into 8 dominant colors
            min_region_area: 1000, // Minimum 1000 pixels for significant regions
        }
    }

    fn update_screenshot_if_needed(&mut self, screen: &ScreenInfo) -> Result<(), opencv::Error> {
        let now = std::time::Instant::now();
        if now.duration_since(self.last_update) > self.refresh_interval || self.screenshot.is_none() {
            // TODO: Implement actual X11 screenshot capture
            // For now, create a dummy image
            self.screenshot = Some(core::Mat::zeros(
                screen.height as i32,
                screen.width as i32,
                core::CV_8UC3,
            )?.to_mat()?);
            
            self.analyze_color_regions()?;
            self.last_update = now;
        }
        Ok(())
    }

    fn analyze_color_regions(&mut self) -> Result<(), opencv::Error> {
        if let Some(ref screenshot) = self.screenshot {
            self.color_regions.clear();

            // Resize image for faster processing
            let mut resized = core::Mat::default();
            let scale_factor = 0.5;
            imgproc::resize(
                screenshot,
                &mut resized,
                core::Size::new(0, 0),
                scale_factor,
                scale_factor,
                imgproc::INTER_LINEAR,
            )?;

            // Perform k-means clustering on color data
            let mut data = core::Mat::default();
            resized.reshape(1, resized.rows() * resized.cols())?.convert_to(&mut data, core::CV_32F, 1.0, 0.0)?;

            let mut labels = core::Mat::default();
            let mut centers = core::Mat::default();
            let criteria = core::TermCriteria::new(
                core::TermCriteria_MAX_ITER + core::TermCriteria_EPS,
                20,
                1.0,
            )?;

            core::kmeans(
                &data,
                self.num_clusters,
                &mut labels,
                criteria,
                3, // attempts
                core::KMEANS_PP_CENTERS,
                &mut centers,
            )?;

            // Convert labels back to image shape
            labels = labels.reshape(1, resized.rows())?;

            // Analyze each cluster to find significant regions
            for cluster_id in 0..self.num_clusters {
                // Create mask for this cluster
                let mut mask = core::Mat::default();
                core::compare(&labels, &core::Scalar::from(cluster_id as f64), &mut mask, core::CMP_EQ)?;

                // Find contours in the mask
                let mut contours = core::Vector::<core::Vector<core::Point>>::new();
                let mut hierarchy = core::Mat::default();
                imgproc::find_contours(
                    &mask,
                    &mut contours,
                    &mut hierarchy,
                    imgproc::RETR_EXTERNAL,
                    imgproc::CHAIN_APPROX_SIMPLE,
                    core::Point::new(0, 0),
                )?;

                // Find the largest contour for this color cluster
                let mut max_area = 0.0;
                let mut best_contour_idx = None;
                
                for i in 0..contours.len() {
                    let contour = contours.get(i)?;
                    let area = imgproc::contour_area(&contour, false)?;
                    
                    if area > max_area && area > (self.min_region_area as f64 * scale_factor * scale_factor) {
                        max_area = area;
                        best_contour_idx = Some(i);
                    }
                }

                if let Some(contour_idx) = best_contour_idx {
                    let contour = contours.get(contour_idx)?;
                    let bounding_rect = imgproc::bounding_rect(&contour)?;
                    
                    // Scale bounding rect back to original image size
                    let scaled_rect = core::Rect::new(
                        (bounding_rect.x as f64 / scale_factor) as i32,
                        (bounding_rect.y as f64 / scale_factor) as i32,
                        (bounding_rect.width as f64 / scale_factor) as i32,
                        (bounding_rect.height as f64 / scale_factor) as i32,
                    );

                    let center = ScreenCoord {
                        x: scaled_rect.x + scaled_rect.width / 2,
                        y: scaled_rect.y + scaled_rect.height / 2,
                    };

                    // Get dominant color from cluster center
                    let center_row = centers.row(cluster_id)?;
                    let b = center_row.at::<f32>(0)? as u8;
                    let g = center_row.at::<f32>(1)? as u8;
                    let r = center_row.at::<f32>(2)? as u8;
                    let dominant_color = core::Vec3b::from([b, g, r]);

                    self.color_regions.push(ColorRegion {
                        center,
                        dominant_color,
                        area: (max_area / (scale_factor * scale_factor)) as i32,
                        bounding_rect: scaled_rect,
                    });
                }
            }

            // Sort regions by area (largest first) for consistent ordering
            self.color_regions.sort_by(|a, b| b.area.cmp(&a.area));

            // Keep only the top 9 regions
            self.color_regions.truncate(9);
        }
        Ok(())
    }

    fn color_to_hex(&self, color: &core::Vec3b) -> String {
        format!("#{:02x}{:02x}{:02x}", color[2], color[1], color[0]) // BGR to RGB hex
    }
}

#[cfg(feature = "vision-grids")]
impl GridLayout for ColorGrid {
    fn calculate_grid(&self, _screen: &ScreenInfo, _density: u32) -> Vec<GridCell> {
        let mut cells = Vec::new();
        
        // Create cells for each significant color region
        for (i, region) in self.color_regions.iter().enumerate() {
            let label = format!("{}", i + 1);
            let cell_size = 40; // Size of selection cell
            
            cells.push(GridCell {
                coord: GridCoord {
                    x: i as u32,
                    y: 0,
                },
                screen_rect: Rectangle {
                    x: region.center.x - cell_size / 2,
                    y: region.center.y - cell_size / 2,
                    width: cell_size as u32,
                    height: cell_size as u32,
                },
                label,
            });
        }

        cells
    }

    fn process_key(&mut self, key: KeyCode, _current_level: u32) -> Option<GridCoord> {
        if let Some(&index) = self.jump_target_map.get(&key) {
            if index < self.color_regions.len() {
                return Some(GridCoord {
                    x: index as u32,
                    y: 0,
                });
            }
        }
        None
    }

    fn process_key_with_screen(
        &mut self,
        key: KeyCode,
        current_level: u32,
        screen: &ScreenInfo,
        _density: u32,
    ) -> Option<GridCoord> {
        // Update screenshot if needed
        if let Err(_) = self.update_screenshot_if_needed(screen) {
            // If screenshot update fails, fall back to basic processing
            return self.process_key(key, current_level);
        }
        
        self.process_key(key, current_level)
    }

    fn name(&self) -> &'static str {
        "Color Clustering Grid"
    }

    fn reset(&mut self) {
        // Force refresh on next use
        self.last_update = std::time::Instant::now() - self.refresh_interval;
    }
}

#[cfg(all(test, feature = "vision-grids"))]
mod tests {
    use super::*;
    use crate::x11_client::ScreenInfo;

    fn mock_screen() -> ScreenInfo {
        ScreenInfo {
            width: 1024,
            height: 768,
            root_window: 0,
        }
    }

    #[test]
    fn test_color_grid_creation() {
        let grid = ColorGrid::new();
        assert_eq!(grid.name(), "Color Clustering Grid");
        assert_eq!(grid.color_regions.len(), 0);
        assert_eq!(grid.num_clusters, 8);
        assert_eq!(grid.min_region_area, 1000);
    }

    #[test]
    fn test_color_grid_key_mapping() {
        let mut grid = ColorGrid::new();
        
        // Add some mock color regions
        grid.color_regions = vec![
            ColorRegion {
                center: ScreenCoord { x: 100, y: 100 },
                dominant_color: core::Vec3b::from([255, 0, 0]), // Blue
                area: 5000,
                bounding_rect: core::Rect::new(80, 80, 40, 40),
            },
            ColorRegion {
                center: ScreenCoord { x: 200, y: 200 },
                dominant_color: core::Vec3b::from([0, 255, 0]), // Green
                area: 3000,
                bounding_rect: core::Rect::new(180, 180, 40, 40),
            },
        ];

        let result = grid.process_key(KEYCODE_1, 0);
        assert!(result.is_some());
        let coord = result.unwrap();
        assert_eq!(coord.x, 0); // First region
        
        let result = grid.process_key(KEYCODE_2, 0);
        assert!(result.is_some());
        let coord = result.unwrap();
        assert_eq!(coord.x, 1); // Second region
    }

    #[test]
    fn test_color_grid_calculate() {
        let mut grid = ColorGrid::new();
        let screen = mock_screen();
        
        // Add some mock color regions
        grid.color_regions = vec![
            ColorRegion {
                center: ScreenCoord { x: 100, y: 100 },
                dominant_color: core::Vec3b::from([255, 0, 0]), // Blue
                area: 5000,
                bounding_rect: core::Rect::new(80, 80, 40, 40),
            },
            ColorRegion {
                center: ScreenCoord { x: 200, y: 200 },
                dominant_color: core::Vec3b::from([0, 255, 0]), // Green
                area: 3000,
                bounding_rect: core::Rect::new(180, 180, 40, 40),
            },
        ];

        let cells = grid.calculate_grid(&screen, 4);
        assert_eq!(cells.len(), 2); // Should have cells for each color region
        
        // Check first cell
        assert_eq!(cells[0].label, "1");
        assert_eq!(cells[0].coord.x, 0);
    }

    #[test]
    fn test_color_to_hex() {
        let grid = ColorGrid::new();
        let blue_bgr = core::Vec3b::from([255, 0, 0]); // BGR format
        let hex = grid.color_to_hex(&blue_bgr);
        assert_eq!(hex, "#0000ff"); // Should convert to RGB hex

        let green_bgr = core::Vec3b::from([0, 255, 0]); // BGR format
        let hex = grid.color_to_hex(&green_bgr);
        assert_eq!(hex, "#00ff00");

        let red_bgr = core::Vec3b::from([0, 0, 255]); // BGR format
        let hex = grid.color_to_hex(&red_bgr);
        assert_eq!(hex, "#ff0000");
    }

    #[test]
    fn test_color_region_sorting() {
        let mut regions = vec![
            ColorRegion {
                center: ScreenCoord { x: 100, y: 100 },
                dominant_color: core::Vec3b::from([255, 0, 0]),
                area: 2000, // Smaller area
                bounding_rect: core::Rect::new(80, 80, 40, 40),
            },
            ColorRegion {
                center: ScreenCoord { x: 200, y: 200 },
                dominant_color: core::Vec3b::from([0, 255, 0]),
                area: 5000, // Larger area
                bounding_rect: core::Rect::new(180, 180, 40, 40),
            },
        ];

        // Sort by area (largest first)
        regions.sort_by(|a, b| b.area.cmp(&a.area));

        // Larger area region should come first
        assert_eq!(regions[0].area, 5000);
        assert_eq!(regions[1].area, 2000);
    }
}